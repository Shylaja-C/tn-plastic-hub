# ─────────────────────────────────────────────
#  TNPlasticHub Backend – Environment Variables
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# PostgreSQL connection
DATABASE_URL=postgresql://tnplastic_user:yourpassword@localhost:5432/tnplastic_hub

# JWT
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
APP_NAME=TNPlasticHub
APP_ENV=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email (optional – for notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@tnplastichub.in

# AI / Gemini  (Member 3 fills this in)
GEMINI_API_KEY=

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
